{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["Client", "Commerçant"] },
        "shopName": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Product listing information",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "sellerPhone": { "type": "string" },
        "sellerCity": { "type": "string" },
        "category": { "type": "string", "enum": ["Immobilier", "Véhicules", "Vêtements", "Chaussures", "Appareils", "Autres"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "price", "sellerId", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message in the chat",
      "type": "object",
      "properties": {
        "text": { "type": "string", "maxLength": 1000 },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "senderId", "receiverId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/produits/{productId}": {
      "schema": "Product",
      "description": "Product listings"
    },
    "/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Chat messages"
    }
  }
}
